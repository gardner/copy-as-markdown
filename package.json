{
  "name": "copy-as-markdown",
  "version": "3.8.1",
  "description": "Copy Link or Image as Markdown code, a Web Extension",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run --project unit --project security-dom --project build",
    "typecheck": "tsc",
    "build": "pnpm run build-chrome && pnpm run build-firefox-mv3",
    "build-chrome": "node scripts/build.js chrome && node scripts/assert-no-turndown.js && node scripts/assert-no-clipboard-mock.js chrome",
    "build-firefox-mv3": "node scripts/build.js firefox-mv3 && node scripts/assert-no-clipboard-mock.js firefox-mv3",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:browser": "vitest run --project browser",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "package:firefox": "pnpm build-firefox-mv3 && node scripts/package-firefox.js",
    "lint:firefox": "addons-linter dist/firefox-extension --warnings-as-errors",
    "sign:firefox": "node scripts/sign-firefox.js",
    "release:prepare": "node scripts/prepare-firefox-release.js",
    "test:security:browser": "pnpm build-chrome && playwright test --config playwright.security.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "3.4.17",
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.4.1",
    "@playwright/test": "1.64.1",
    "@truto/turndown-plugin-gfm": "1.0.2",
    "@types/chrome": "0.1.31",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "addons-linter": "10.14.0",
    "bulma": "1.0.0",
    "esbuild": "0.28.1",
    "eslint": "9.37.0",
    "jsdom": "30.1.1",
    "jszip": "3.10.2",
    "turndown": "7.1.3",
    "typescript": "5.4.5",
    "vitest": "4.1.11",
    "web-ext": "10.7.0",
    "webextension-polyfill": "0.12.0",
    "yauzl": "3.4.0"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2"
}
